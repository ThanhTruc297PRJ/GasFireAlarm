{
  "version": 1,
  "author": "GasFireAlarm ESP32",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp",   "top": 200, "left": 280, "attrs": {} },
    { "type": "wokwi-gas-sensor",      "id": "mq2",   "top": 20,  "left": 20,  "attrs": { "ppm": "400" } },
    { "type": "wokwi-dht22",           "id": "dht1",  "top": 20,  "left": 200, "attrs": { "temperature": "35", "humidity": "60" } },
    { "type": "wokwi-pushbutton",      "id": "flame", "top": 20,  "left": 380, "attrs": { "color": "red", "label": "FLAME" } },
    { "type": "wokwi-pushbutton",      "id": "btnReset", "top": 120, "left": 380, "attrs": { "color": "green", "label": "RESET" } },
    { "type": "wokwi-led",             "id": "ledG",  "top": 20,  "left": 560, "attrs": { "color": "green" } },
    { "type": "wokwi-led",             "id": "ledY",  "top": 20,  "left": 620, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led",             "id": "ledR",  "top": 20,  "left": 680, "attrs": { "color": "red" } },
    { "type": "wokwi-buzzer",          "id": "bz1",   "top": 120, "left": 560, "attrs": { "volume": "0.5" } },
    { "type": "wokwi-servo",           "id": "sv1",   "top": 120, "left": 680, "attrs": {} },
    { "type": "wokwi-led",             "id": "fan1",  "top": 240, "left": 560, "attrs": { "color": "blue", "label": "Quat" } },
    { "type": "wokwi-lcd1602",         "id": "lcd1",  "top": 460, "left": 20,  "attrs": { "pins": "i2c" } }
  ],
  "connections": [
    ["mq2:AOUT",  "esp:D34",   "green",  ["h0"]],
    ["mq2:VCC",   "esp:3V3",   "red",    ["h0"]],
    ["mq2:GND",   "esp:GND.1", "black",  ["h0"]],

    ["dht1:SDA",  "esp:D15",   "blue",   ["h0"]],
    ["dht1:VCC",  "esp:3V3",   "red",    ["h0"]],
    ["dht1:GND",  "esp:GND.1", "black",  ["h0"]],

    ["flame:1.l", "esp:D4",    "orange", ["h0"]],
    ["flame:2.l", "esp:GND.1", "black",  ["h0"]],

    ["btnReset:1.l", "esp:D18",   "green", ["h0"]],
    ["btnReset:2.l", "esp:GND.1", "black", ["h0"]],

    ["ledG:A",    "esp:D25",   "green",  ["v0"]],
    ["ledG:C",    "esp:GND.2", "black",  ["v0"]],

    ["ledY:A",    "esp:D26",   "yellow", ["v0"]],
    ["ledY:C",    "esp:GND.2", "black",  ["v0"]],

    ["ledR:A",    "esp:D27",   "red",    ["v0"]],
    ["ledR:C",    "esp:GND.2", "black",  ["v0"]],

    ["bz1:1",     "esp:D14",   "purple", ["h0"]],
    ["bz1:2",     "esp:GND.1", "black",  ["h0"]],

    ["fan1:A",    "esp:D12",   "cyan",   ["h0"]],
    ["fan1:C",    "esp:GND.1", "black",  ["h0"]],

    ["sv1:PWM",   "esp:D13",   "orange", ["h0"]],
    ["sv1:V+",    "esp:3V3",   "red",    ["h0"]],
    ["sv1:GND",   "esp:GND.1", "black",  ["h0"]],

    ["lcd1:SDA",  "esp:D21",   "blue",   ["h0"]],
    ["lcd1:SCL",  "esp:D22",   "yellow", ["h0"]],
    ["lcd1:VCC",  "esp:3V3",   "red",    ["h0"]],
    ["lcd1:GND",  "esp:GND.1", "black",  ["h0"]]
  ]
}
