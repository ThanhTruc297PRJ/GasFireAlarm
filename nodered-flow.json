  {
    "id": "fn_log",
    "type": "function",
    "z": "f1",
    "name": "Log canh bao",
    "func": "var data = msg.payload;\nvar state = data.state;\nvar prevState = context.get('prevState') || 'BINH THUONG';\nif (state !== prevState) {\n  context.set('prevState', state);\n  if (state !== 'BINH THUONG') {\n    var logs = context.get('logs') || [];\n    var now = new Date();\n    var h = now.getHours().toString().padStart(2,'0');\n    var m = now.getMinutes().toString().padStart(2,'0');\n    var s = now.getSeconds().toString().padStart(2,'0');\n    var color = state==='CHAY'?'#e74c3c':state==='NGUY HIEM'?'#e67e22':state==='MAT KET NOI'?'#7f8c8d':'#f39c12';\n    logs.unshift({time:h+':'+m+':'+s, state:state, gas:data.gas, temp:data.temp, color:color});\n    if (logs.length > 8) logs = logs.slice(0,8);\n    context.set('logs', logs);\n  }\n}\nmsg.payload = context.get('logs') || [];\nreturn msg;",
    "outputs": 1,
    "x": 1100,
    "y": 640,
    "wires": [
      [
        "tpl_log"
      ]
    ]
  },
  {
    "id": "tele_check",
    "type": "function",
    "z": "f1",
    "name": "Kiem tra canh bao",
    "func": "// Chi gui Telegram khi: muc canh bao TANG, he thong TRO LAI binh thuong,\n// hoac thiet bi KET NOI LAI sau khi mat ket noi. Ha muc (VD CHAY -> NGUY HIEM)\n// khong gui de tranh spam.\nvar SEV = {'BINH THUONG':0, 'CANH BAO':1, 'NGUY HIEM':2, 'CHAY':3};\nvar data = msg.payload || {};\nvar state = data.state;\nif (!(state in SEV)) return null;\n\nvar prevState = context.get('prevState') || 'BINH THUONG';\nvar wasOffline = flow.get('deviceOffline') === true;\nflow.set('deviceOffline', false);\ncontext.set('prevState', state);\n\nvar tag = (data.source && data.source !== 'esp32') ? '[GIA LAP: ' + data.source + '] ' : '';\nvar text = null;\n\nif (wasOffline) {\n  text = '📶 ' + tag + 'THIET BI DA KET NOI LAI\\nTrang thai: ' + state;\n} else if (SEV[state] > SEV[prevState]) {\n  var emoji = state === 'CHAY' ? '🔥' : state === 'NGUY HIEM' ? '🚨' : '⚠️';\n  text = emoji + ' ' + tag + 'CANH BAO HE THONG GAS & CHAY' +\n    '\\nTrang thai: ' + state +\n    '\\nGas: ' + data.gas + ' ppm' +\n    '\\nNhiet do: ' + data.temp + 'C' + (data.dhtError ? ' (LOI CAM BIEN)' : '') +\n    '\\nLua: ' + data.flame +\n    (data.valve ? '\\nVan gas: ' + data.valve : '');\n} else if (SEV[state] === 0 && SEV[prevState] > 0) {\n  text = '✅ ' + tag + 'HE THONG DA TRO LAI BINH THUONG' +\n    '\\nGas: ' + data.gas + ' ppm\\nNhiet do: ' + data.temp + 'C';\n}\nif (!text) return null;\n\nvar token = env.get('TG_TOKEN');\nvar chatId = env.get('TG_CHAT_ID');\nif (!token || !chatId) { node.warn('Chua cau hinh bien moi truong TG_TOKEN / TG_CHAT_ID'); return null; }\nmsg.url = 'https://api.telegram.org/bot' + token + '/sendMessage';\nmsg.payload = { chat_id: chatId, text: text };\nreturn msg;",
    "outputs": 1,
    "x": 1100,
    "y": 740,
    "wires": [
      [
        "tele_send"
      ]
    ]
  },
  {
    "id": "tele_offline",
    "type": "function",
    "z": "f1",
    "name": "Canh bao mat ket noi",
    "func": "// Gui 1 lan moi khi mat ket noi (co lai du lieu thi tele_check xoa co)\nif (flow.get('deviceOffline') === true) return null;\nflow.set('deviceOffline', true);\nvar text = '📡 MAT KET NOI THIET BI\\nKhong nhan duoc du lieu trong 10 giay.\\nKiem tra nguon dien / WiFi cua thiet bi.';\n\nvar token = env.get('TG_TOKEN');\nvar chatId = env.get('TG_CHAT_ID');\nif (!token || !chatId) { node.warn('Chua cau hinh bien moi truong TG_TOKEN / TG_CHAT_ID'); return null; }\nmsg.url = 'https://api.telegram.org/bot' + token + '/sendMessage';\nmsg.payload = { chat_id: chatId, text: text };\nreturn msg;",
    "outputs": 1,
    "x": 1100,
    "y": 780,
    "wires": [
      [
        "tele_send"
      ]
    ]
  },
