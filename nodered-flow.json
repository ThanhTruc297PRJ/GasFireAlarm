  {
    "id": "tele_result",
    "type": "function",
    "z": "f1",
    "name": "Ket qua Telegram",
    "func": "var res = {};\ntry { res = JSON.parse(msg.payload); } catch (e) {}\nmsg.topic = 'Telegram';\nif (res.ok) {\n  if (!msg.isTest) return null;          // canh bao that gui thanh cong: khong can bao\n  msg.payload = '✅ Da gui tin nhan thu Telegram';\n  return msg;\n}\nvar why = res.description || ('HTTP ' + msg.statusCode);\nnode.warn('Gui Telegram loi: ' + why);\nmsg.payload = '❌ Gui Telegram loi: ' + why;\nreturn msg;",
    "outputs": 1,
    "x": 1600,
