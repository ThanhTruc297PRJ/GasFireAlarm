    "format": "<div ng-style=\"{'background': msg.payload.state=='CHAY'?'#c0392b':msg.payload.state=='NGUY HIEM'?'#e67e22':msg.payload.state=='CANH BAO'?'#f39c12':msg.payload.state=='MAT KET NOI'?'#7f8c8d':'#27ae60', 'padding':'18px', 'border-radius':'12px', 'text-align':'center', 'color':'white', 'transition':'background 0.5s ease'}\">\n  <div style=\"font-size:11px;letter-spacing:3px;opacity:0.85\">TRANG THAI HE THONG</div>\n  <div style=\"font-size:30px;font-weight:bold;margin-top:8px\">\n    <span ng-if=\"msg.payload.state=='CHAY'\">🔥 CHAY !!!</span>\n    <span ng-if=\"msg.payload.state=='NGUY HIEM'\">🚨 NGUY HIEM</span>\n    <span ng-if=\"msg.payload.state=='CANH BAO'\">⚠️ CANH BAO</span>\n    <span ng-if=\"msg.payload.state=='BINH THUONG'\">✅ BINH THUONG</span>\n    <span ng-if=\"msg.payload.state=='MAT KET NOI'\">📡 MAT KET NOI THIET BI</span>\n    <span ng-if=\"!msg.payload.state\" style=\"opacity:0.6\">-- Cho du lieu --</span>\n  </div>\n  <div ng-if=\"msg.payload.latched\" style=\"font-size:13px;margin-top:8px\">🔒 Van gas dang khoa – bam RESET khi cam bien da an toan</div>\n  <div ng-if=\"msg.payload.source && msg.payload.source!='esp32'\" style=\"font-size:11px;margin-top:6px;opacity:0.85\">Nguon du lieu: {{msg.payload.source}} (gia lap)</div>\n</div>",
    "storeOutMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 1380,
    "y": 540,
    "wires": [
      []
    ]
