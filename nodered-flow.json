  {
    "id": "fn_status",
    "type": "function",
    "z": "f1",
    "name": "Trang thai + khoa",
    "func": "var d = msg.payload || {};\nmsg.payload = { state: d.state, latched: d.latched === true, source: d.source || '' };\nreturn msg;",
