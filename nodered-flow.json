  {
    "id": "tele_test",
    "type": "function",
    "z": "f1",
    "name": "Tin nhan thu",
    "func": "// Output 1 -> Gui Telegram, output 2 -> thong bao tren dashboard\nvar token = env.get('TG_TOKEN');\nvar chatId = env.get('TG_CHAT_ID');\nif (!token || !chatId) {\n  return [null, { topic: 'Telegram', payload: '⚠️ Chua cau hinh TG_TOKEN / TG_CHAT_ID tren may chay Node-RED' }];\n}\nmsg.url = 'https://api.telegram.org/bot' + token + '/sendMessage';\nmsg.isTest = true;\nmsg.payload = { chat_id: chatId,\n  text: '🧪 TIN NHAN THU\\nHe thong canh bao gas & chay dang hoat dong.\\nThoi gian: ' + new Date().toLocaleString('vi-VN') };\nreturn [msg, null];",
