  {
    "id": "src_filter",
    "type": "function",
    "z": "f1",
    "name": "Uu tien ESP32",
    "func": "// Output 1: du lieu hop le. Output 2: thong bao len dashboard.\nvar ESP32_WINDOW_MS = 15000;   // ESP32 gui moi 2s; 15s khong thay -> coi nhu offline\nvar src = (msg.payload && msg.payload.source) || 'esp32';\nvar now = Date.now();\nif (src === 'esp32') {\n  flow.set('lastEsp32', now);\n  node.status({ fill: 'green', shape: 'dot', text: 'nguon: esp32' });\n  return [msg, null];\n}\nvar lastEsp32 = flow.get('lastEsp32') || 0;\nif (now - lastEsp32 < ESP32_WINDOW_MS) {\n  node.status({ fill: 'yellow', shape: 'ring', text: 'bo qua du lieu ' + src });\n  // Bao toi da 1 lan / 30s de khong spam\n  var lastWarn = context.get('lastWarn') || 0;\n  if (now - lastWarn < 30000) return [null, null];\n  context.set('lastWarn', now);\n  return [null, { topic: 'Du lieu gia lap', payload: '⚠️ ESP32 dang online – bo qua du lieu gia lap tu \"' + src + '\". Hay tat ' + src + '.' }];\n}\nnode.status({ fill: 'blue', shape: 'dot', text: 'nguon: ' + src });\nreturn [msg, null];",
    "outputs": 2,
    "x": 580,
    "y": 100,
    "wires": [
      [
        "change_gas",
        "change_temp",
        "change_flame",
        "change_state",
        "fn_status",
        "fn_chart",
        "fn_log",
        "tele_check",
        "watchdog",
        "text_valve",
        "text_fan",
        "text_latched",
        "text_dht",
        "text_source"
      ],
      [
        "lo_toast_data"
      ]
    ]
  },
